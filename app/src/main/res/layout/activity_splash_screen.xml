<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    tools:context=".SplashScreen">

    <!-- Espaciador superior (Invisible) -->
    <!-- Este primer View con weight=1 se equilibra con el segundo,
         centrando el contenido de Lottie + Imagen en el centro de la pantalla. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 1. Animación Lottie (El mundo) - Ahora centrado verticalmente -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_earth"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:lottie_autoPlay="true"
        app:lottie_fileName="Green earth.json"
        app:lottie_imageAssetsFolder="assets"
        app:lottie_loop="true"
        android:layout_marginBottom="5dp"
        android:layout_marginTop="0dp" /> <!-- Se eliminó el margen superior fijo (100dp) -->

    <!-- 2. ImageView (El nombre "City Go" en verde - imagen) -->
    <ImageView
        android:id="@+id/img_app_name"
        android:layout_width="200dp"
        android:layout_height="100dp"
        android:src="@drawable/nombrapp"
        android:layout_marginTop="1dp"
        android:contentDescription="@string/nombre_app"
        android:scaleType="fitCenter"/>

    <!-- Separador invisible: Usa layout_weight="1" para empujar la versión hacia la parte inferior. -->
    <!-- Al tener el mismo peso que el View superior, el contenido Lottie+Imagen queda centrado. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 3. TextView (Versión de la aplicación) - Al final y centrado horizontalmente -->
    <TextView
        android:id="@+id/txt_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/version"
        android:textColor="@color/black"
        android:layout_marginBottom="32dp"
        android:layout_gravity="center_horizontal"/>
</LinearLayout>