<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Orden numérico circular -->
        <TextView
            android:id="@+id/tvTramoOrden"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_icon_button"
            android:backgroundTint="@color/orange_light"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/orange_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTramoCalleNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Av. José Balta (Cuadras 1 a 6)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTramoTiempoEstimado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="⏱️ Tiempo estimado: 25 min"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Botón Marcar Tramo Completado -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompletarTramo"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Completar"
            android:textColor="@color/green_primary"
            android:textSize="11sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/green_primary" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
